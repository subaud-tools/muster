{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "${HOME}/.local/bin/muster hook SessionStart codex",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "${HOME}/.local/bin/muster hook Stop codex",
            "type": "command"
          }
        ]
      }
    ]
  }
}
