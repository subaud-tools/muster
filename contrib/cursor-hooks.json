{
  "hooks": {
    "sessionEnd": [
      {
        "command": "${HOME}/.local/bin/muster hook SessionEnd cursor"
      }
    ],
    "sessionStart": [
      {
        "command": "${HOME}/.local/bin/muster hook SessionStart cursor"
      }
    ],
    "stop": [
      {
        "command": "${HOME}/.local/bin/muster hook Stop cursor",
        "loop_limit": 3
      }
    ]
  },
  "version": 1
}
