{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "~/.local/bin/muster hook SessionEnd claude",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.local/bin/muster hook SessionStart claude",
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.local/bin/muster hook Stop claude",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.local/bin/muster hook UserPromptSubmit claude",
            "type": "command"
          }
        ]
      }
    ]
  }
}
